---
import Layout from '~/layout/layout.astro'
import Card, { type Props as CardProps } from '~/components/card/card.astro'
import DateGroup from '~/components/date-group/date-group.astro'
import { site } from '~/config/site'

// No content collection is wired in this ticket, so both lists are empty by construction. The
// build session replaces these two declarations with getCollection() calls — every branch below
// is already written against the shape they will return, including the branch that ships today.
const work: CardProps[] = []
const groups: { date: Date; posts: CardProps[] }[] = []
---

{/*
	`titleTag="h1"` because on the homepage the site is the subject; every inner route leaves the
	band as a `p` and owns its own `h1`. The two labels below are therefore section headings.
*/}
<Layout title={site.title} description={site.tagline} titleTag="h1">
	{/*
		The top slot is the newest Work, not the newest dated post. This is the one place the
		era's own form does not supply the answer, and the user decided the work leads
		(DESIGN.md, Layout). It is a deliberate departure — do not "correct" it back.

		Work and Blog are peers in treatment. An earlier pass demoted Blog to `text-quiet` to
		express the lead; that was wrong twice over — source order already carries it, and
		PRODUCT.md's peer-developer audience arrives for the writing, so the blog is that
		reader's front door.
	*/}
	<h2 class="mb-3 font-display text-section tracking-furniture uppercase">Work</h2>

	{/*
		The empty branch renders no cover frame. The heading is the furniture that stays; a cover
		is content, and an unlabeled 96px grey box is content that says nothing the sentence does
		not. The sidebar to the right is the system's own answer to an empty slot: heading,
		hairline, one sentence.
	*/}
	{
		work.length > 0 ? (
			<Card {...work[0]} eager class="border-t-0 pt-0" />
		) : (
			<p class="mb-8 max-w-measure">
				I haven't published anything here yet. When I do, the newest piece of work leads
				this column.
			</p>
		)
	}

	<h2
		class="mt-8 mb-3 border-t border-rule pt-4 font-display text-section tracking-furniture uppercase"
	>
		Blog
	</h2>

	{
		groups.length > 0 ? (
			groups.map((group) => (
				<DateGroup date={group.date}>
					{group.posts.map((post) => (
						<Card {...post} />
					))}
				</DateGroup>
			))
		) : (
			<p class="max-w-measure">
				Nothing written yet either. Posts will land here, grouped under the day they went
				up.
			</p>
		)
	}
</Layout>
