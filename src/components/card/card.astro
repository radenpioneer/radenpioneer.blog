---
// Wrapper. Named slots are how Astro-rendered markup reaches a React component as a prop, so
// the cover is composed here — Cover is itself a wrapper around `astro:assets` — and arrives in
// the React half already rendered.
import type { ImageMetadata } from 'astro'
import Cover from '~/components/cover/cover.astro'
import { Card, type CardProps } from './card'

export type Props = Omit<CardProps, 'className' | 'cover' | 'hasByline' | 'byline' | 'children'> & {
	class?: string
	cover?: ImageMetadata
	coverAlt?: string
	loading?: 'eager' | 'lazy'
}

const { class: className, cover, coverAlt = '', loading = 'lazy', ...props } = Astro.props
---

<Card {...props} className={className} hasByline={Astro.slots.has('byline')}>
	{
		cover && (
			<Fragment slot="cover">
				<Cover image={cover} alt={coverAlt} loading={loading} />
			</Fragment>
		)
	}

	<slot />

	{
		Astro.slots.has('byline') && (
			<Fragment slot="byline">
				<slot name="byline" />
			</Fragment>
		)
	}
</Card>
