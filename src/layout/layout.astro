---
// This layout owns the whole assembly: the bands, the nav strip, the white column, and the
// sidebar. A page only ever fills the main column, because the assembly is the site's identity
// and no route gets to reshape it.
import './global.css'
import BaseLayout, { type Props as BaseProps } from './base.astro'
import Assembly from '~/components/assembly/assembly.astro'
import Band from '~/components/band/band.astro'
import SiteNav from '~/components/site-nav/site-nav.astro'
import SiteFurniture from '~/components/site-furniture/site-furniture.astro'
import { site, socials } from '~/config/site'
import { absoluteUrl } from '~/lib/seo'

export type Props = BaseProps & {
	/**
	 * The element the site title in the header band renders as. On the homepage the site *is*
	 * the subject, so it is the `h1`; on every inner page it is a link back and the route owns
	 * its own `h1`. Passed explicitly rather than sniffed from the pathname.
	 */
	titleTag?: 'h1' | 'p'
}

const { titleTag = 'p', ...props } = Astro.props

const SiteTitle = titleTag
const year = new Date().getFullYear()
---

<BaseLayout {...props}>
	<div class="px-3 py-6 sm:px-4 sm:py-8">
		<Assembly class="border border-rule">
			<Band as="header" class="px-4 py-5">
				<SiteTitle class="font-display text-title tracking-band uppercase">
					<a href="/" class="text-column no-underline hover:underline">{site.title}</a>
				</SiteTitle>
				<p class="mt-1.5 font-ui text-furniture tracking-furniture uppercase">
					{site.tagline}
				</p>
			</Band>

			<SiteNav />

			{/*
				Padding lives on the columns, never on this grid, so the sidebar's hairline runs
				the full height of the row and meets the nav rule above and the footer band
				below. A rule that stops short of the rules it should join is a visible join
				failure in a system whose whole depth vocabulary is 1px hairlines.

				Main drops its right padding at `md` so the 24px gutter is the entire separation
				between the column and the rule, rather than stacking on top of it.
			*/}
			<div
				class="grid grid-cols-1 bg-column md:grid-cols-[1fr_var(--spacing-sidebar)] md:gap-x-gutter"
			>
				<main class="p-4 md:pr-0">
					<slot />
				</main>

				<aside class="border-t border-rule p-4 md:border-t-0 md:border-l">
					<slot name="sidebar"><SiteFurniture /></slot>
				</aside>
			</div>

			<Band as="footer" class="px-4 py-3 font-ui text-furniture">
				<p>&copy; {year} {site.title}</p>
				{/*
					Contact is the footer's job (PRODUCT.md), so the slot stays installed when it
					is empty — the same answer the sidebar gives four lines up, and the same
					register as its "No tags yet." Letting it vanish would make contact the one
					piece of furniture in the system that disappears rather than showing its
					absence. Not a period idiom: it states a fact in the current voice.
				*/}
				{
					socials.length > 0 ? (
						<ul class="mt-1 flex flex-wrap gap-x-3">
							{socials.map(({ label, href }) => (
								<li>
									<a href={href} class="text-column">
										{label}
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="mt-1">No contact links yet.</p>
					)
				}
			</Band>
		</Assembly>
	</div>

	<Fragment slot="head">
		<link rel="canonical" href={absoluteUrl(Astro.url.pathname, Astro.site)} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		{/* TODO: Common layout SEO tags — the Common tier of ticket 15's layer table */}
		<slot name="head" />
	</Fragment>
</BaseLayout>
