---
// Common layout. Sitewide UI shared across page types (nav, footer, etc.) on top of Base — used directly by routes with no Type layout of their own, or extended by one (blog.astro, work.astro).
//
// This layout owns the whole assembly: the bands, the nav strip, the white column, and the
// sidebar. A page only ever fills the main column, because the assembly is the site's identity
// and no route gets to reshape it.
import './global.css'
import BaseLayout, { type Props as BaseProps } from './base.astro'
import Assembly from '~/components/assembly/assembly.astro'
import Band from '~/components/band/band.astro'
import SiteNav from '~/components/site-nav/site-nav.astro'
import SiteFurniture from '~/components/site-furniture/site-furniture.astro'
import { site } from '~/config/site'

export type Props = BaseProps & {
	title?: string
	description?: string
	/**
	 * The element the site title in the header band renders as. On the homepage the site *is*
	 * the subject, so it is the `h1`; on every inner page it is a link back and the route owns
	 * its own `h1`. Passed explicitly rather than sniffed from the pathname.
	 */
	titleTag?: 'h1' | 'p'
}

const { title, description, titleTag = 'p', ...props } = Astro.props

//TODO: Sitewide imports for title & description

const SiteTitle = titleTag
const year = new Date().getFullYear()
---

<BaseLayout {...props}>
	<div class="px-3 py-6 sm:px-4 sm:py-8">
		<Assembly class="border border-rule">
			<Band as="header" class="px-4 py-5">
				<SiteTitle class="font-display text-title tracking-band uppercase">
					<a href="/" class="text-column no-underline hover:underline">{site.title}</a>
				</SiteTitle>
				<p class="mt-1.5 font-ui text-furniture tracking-furniture uppercase">
					{site.tagline}
				</p>
			</Band>

			<SiteNav />

			<!--
				The assembly's one responsive departure from the era (DESIGN.md, Layout): below
				its own width the sidebar unstacks beneath the main column. Every internal
				measure holds.
			-->
			<div class="grid grid-cols-1 bg-column md:grid-cols-[1fr_var(--spacing-sidebar)]">
				<main class="p-4">
					<slot />
				</main>

				<aside class="border-t border-rule p-4 md:border-t-0 md:border-l">
					<slot name="sidebar"><SiteFurniture /></slot>
				</aside>
			</div>

			<Band as="footer" class="px-4 py-3 font-ui text-furniture">
				<p>&copy; {year} {site.title}</p>
			</Band>
		</Assembly>
	</div>

	<Fragment slot="head">
		<!-- TODO: conditionally use sitewide configurations -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<!-- TODO: Common layout SEO tags -->
		<slot name="head" />
	</Fragment>
</BaseLayout>
